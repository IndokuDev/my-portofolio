---
import Layout from "../layouts/Layout.astro";
import App from "../components/App.tsx";

// Pull real repos at build time. If GitHub is unreachable the page still builds
// and the Work section falls back to a "see my GitHub" card.
let projects = [];
try {
  const res = await fetch(
    "https://api.github.com/users/indokudev/repos?sort=updated&per_page=30",
    { headers: { Accept: "application/vnd.github+json", "User-Agent": "indokudev-site" } },
  );
  if (res.ok) {
    const repos = await res.json();
    projects = repos
      .filter((r) => !r.fork && !r.archived && r.description && r.name !== "indokudev")
      .sort((a, b) => b.stargazers_count - a.stargazers_count)
      .slice(0, 6)
      .map((r) => ({
        name: r.name,
        description: r.description,
        url: r.homepage || r.html_url,
        language: r.language,
        stars: r.stargazers_count,
      }));
  }
} catch {
  // keep empty fallback
}
---

<Layout>
  <App client:idle projects={projects} />
</Layout>
